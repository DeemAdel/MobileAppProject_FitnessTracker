<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F7F2FA">
    <TextView
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#7030A0"
        android:gravity="center"
        android:text="Daily Goal"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"/>



        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="🎯"
                android:textSize="60sp"
                android:layout_marginBottom="24dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Exercise Goal (minutes)"
                android:textColor="#333333"
                android:textSize="18sp"/>

            <EditText
                android:id="@+id/etExerciseGoal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:hint="Enter exercise goal"
                android:inputType="number"
                android:textColor="#333333"
                android:textColorHint="#777777"
                android:layout_marginBottom="20dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Water Goal (ml)"
                android:textColor="#333333"
                android:textSize="18sp"/>

            <EditText
                android:id="@+id/etWaterGoal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:hint="Enter water goal"
                android:inputType="number"
                android:textColor="#333333"
                android:textColorHint="#777777"
                android:layout_marginBottom="20dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Calorie Goal (kcal)"
                android:textColor="#333333"
                android:textSize="18sp"/>

            <EditText
                android:id="@+id/etCalorieGoal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:hint="Enter calorie goal"
                android:inputType="number"
                android:textColor="#333333"
                android:textColorHint="#777777"
                android:layout_marginBottom="24dp"/>

            <Button
                android:id="@+id/btnSaveGoal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Save Goal"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:backgroundTint="#7030A0"/>

        </LinearLayout>
</LinearLayout>