<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <!-- Purple Header -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#8653DC"
        android:gravity="center"
        android:text="Water &amp; Calories"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Water and Apple Icons -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="45dp"
            android:gravity="center"
            android:text="💧 🍎"
            android:textSize="55sp"/>

        <!-- Water Label -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Water Intake (ml)"
            android:textColor="#333333"
            android:textSize="16sp"/>

        <!-- Water Input -->
        <EditText
            android:id="@+id/etWater"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Enter water intake"
            android:inputType="number"
            android:textSize="16sp"/>

        <!-- Calories Label -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="Calories Intake (kcal)"
            android:textColor="#333333"
            android:textSize="16sp"/>

        <!-- Calories Input -->
        <EditText
            android:id="@+id/etCalories"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Enter calories intake"
            android:inputType="number"
            android:textSize="16sp"/>

        <!-- Save Button -->
        <Button
            android:id="@+id/btnSaveIntake"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="35dp"
            android:text="Save Intake"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:backgroundTint="#8653DC"/>

    </LinearLayout>

</LinearLayout>