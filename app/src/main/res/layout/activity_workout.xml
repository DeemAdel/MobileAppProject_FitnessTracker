<?xml version="1.0" encoding="utf-8"?>
<LinearLayout

    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F0FF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#6A3FB5"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@android:drawable/ic_media_previous"
            android:contentDescription="back"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:text="Add Workout"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"/>

    </LinearLayout>

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

<ImageView
    android:layout_width="64dp"
    android:layout_height="64dp"
    android:layout_gravity="center_horizontal"
    android:src="@drawable/ic_workout"
    android:contentDescription="workout icon"/>

<TextView
android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="16dp"
    android:text="Workout Type"
    android:textStyle="bold"
    android:textColor="#000000"/>

<Spinner
android:id="@+id/spinnerType"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:layout_marginTop="6dp"
    android:background="@android:drawable/btn_dropdown"
    android:spinnerMode="dropdown"/>

<TextView
android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="16dp"
    android:text="Duration (minutes)"
    android:textStyle="bold"
    android:textColor="#000000"/>

<EditText
android:id="@+id/etDuration"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:layout_marginTop="6dp"
    android:background="#FFFFFF"
    android:inputType="number"
    android:hint="30"
    android:paddingStart="12dp"
    android:textColor="#000000"
    android:textColorHint="#888888"/>

<TextView
android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="16dp"
    android:text="Date"
    android:textStyle="bold"
    android:textColor="#FFFFFF"/>

<EditText
android:id="@+id/etDate"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:layout_marginTop="6dp"
    android:background="#FFFFFF"
    android:drawableStart="@drawable/ic_calendar"
    android:drawablePadding="12dp"
    android:drawableTint="#6A3FB5"
    android:inputType="none"
    android:focusable="false"
    android:hint="Nov 2, 2026"
    android:paddingStart="12dp"
    android:textColor="#000000"
    android:textColorHint="#888888"/>

<Button
android:id="@+id/btnSave"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="32dp"
    android:backgroundTint="#6A3FB5"
    android:drawableStart="@drawable/ic_save"
    android:drawableTint="#FFFFFF"
    android:text="Save Workout"
    android:textColor="#FFFFFF"/>

    </LinearLayout>
    </LinearLayout>
